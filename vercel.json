{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "regions": [
    "dub1"
  ],
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/generate.ts": {
      "maxDuration": 300,
      "includeFiles": "public/library/refs/**"
    },
    "api/coloring.ts": {
      "maxDuration": 300
    },
    "api/guide.ts": {
      "maxDuration": 120
    }
  }
}
